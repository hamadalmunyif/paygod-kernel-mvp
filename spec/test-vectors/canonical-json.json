[
  {
    "description": "Simple object with unsorted keys",
    "input": {
      "c": 3,
      "a": 1,
      "b": 2
    },
    "expected_canonical": "{\"a\":1,\"b\":2,\"c\":3}",
    "expected_hash": "e6a3385fb77c287a712e7f406a451727f0625041823ecf23bea7ef39b2e39805"
  },
  {
    "description": "Object with whitespace semantic equivalent",
    "input": {
      "a": 1,
      "b": 2
    },
    "expected_canonical": "{\"a\":1,\"b\":2}",
    "expected_hash": "43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777"
  },
  {
    "description": "Nested object sorting",
    "input": {
      "z": {
        "y": 2,
        "x": 1
      },
      "a": 1
    },
    "expected_canonical": "{\"a\":1,\"z\":{\"x\":1,\"y\":2}}",
    "expected_hash": "4a1cd3abb367ad5a1a93fd454f6ff43b1e42707b8bd7450d7952fc9ae37aea28"
  },
  {
    "description": "Unicode values are preserved and escaped",
    "input": {
      "text": "مرحبا بالعالم",
      "emoji": "🚀",
      "mixed": "A©B"
    },
    "expected_canonical": "{\"emoji\":\"\\ud83d\\ude80\",\"mixed\":\"A\\u00a9B\",\"text\":\"\\u0645\\u0631\\u062d\\u0628\\u0627 \\u0628\\u0627\\u0644\\u0639\\u0627\\u0644\\u0645\"}",
    "expected_hash": "3da216704bfc21fcfa75988bee755949bc82e6629e56d19e9597a04f99a4c0c5"
  },
  {
    "description": "Escaping special characters",
    "input": {
      "quote": "\"",
      "backslash": "\\",
      "backspace": "\b",
      "formfeed": "\f",
      "newline": "\n",
      "return": "\r",
      "tab": "\t"
    },
    "expected_canonical": "{\"backslash\":\"\\\\\",\"backspace\":\"\\b\",\"formfeed\":\"\\f\",\"newline\":\"\\n\",\"quote\":\"\\\"\",\"return\":\"\\r\",\"tab\":\"\\t\"}",
    "expected_hash": "c9a0a0c7789b970301a0e528e633a8529eb257a9538c8ce9c8a23b1886eb0a19"
  },
  {
    "description": "Arrays and nested structures",
    "input": {
      "list": [
        3,
        2,
        1
      ],
      "nested": [
        {
          "b": 2,
          "a": 1
        },
        0
      ]
    },
    "expected_canonical": "{\"list\":[3,2,1],\"nested\":[{\"a\":1,\"b\":2},0]}",
    "expected_hash": "2fcfbded120ffe9e634ee9d7010d28ebf90b46707d8dfd6b7666091365ad044c"
  },
  {
    "description": "Safe integer boundaries",
    "input": {
      "max": 9007199254740991,
      "min": -9007199254740991,
      "zero": 0
    },
    "expected_canonical": "{\"max\":9007199254740991,\"min\":-9007199254740991,\"zero\":0}",
    "expected_hash": "b7b2401ddca2165824e98c61890c0aaec470258d3119dd265d02be9438bf47e6"
  },
  {
    "description": "Decomposed Unicode string value is preserved",
    "input": {
      "text": "é"
    },
    "expected_canonical": "{\"text\":\"e\\u0301\"}",
    "expected_hash": "2169722aee46a09ad91bae5ad6e5eb68e327438cdf02e2e04fe951f97ba466e8"
  },
  {
    "description": "Floating point is rejected",
    "input": {
      "amount": 0.1
    },
    "expected_error": "floating-point"
  },
  {
    "description": "Unsafe integer is rejected",
    "input": {
      "amount": 9007199254740992
    },
    "expected_error": "safe range"
  },
  {
    "description": "Non-NFC property name is rejected",
    "input": {
      "é": "value"
    },
    "expected_error": "not NFC"
  }
]
